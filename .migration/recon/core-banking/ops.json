      "collation_casefold"
    ],
    "source_sql": "SELECT id, number, type, status, actual_balance AS actualBalance, available_balance AS availableBalance, user_id AS userId FROM banking_core_account WHERE number = '100015003000'",
    "target_pipeline": [
