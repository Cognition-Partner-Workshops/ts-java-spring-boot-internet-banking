# Copy to docker-compose/.env (git-ignored) and fill in real values before `docker compose up`.
# Every value is required; compose refuses to start with a missing one.
# Generate values with e.g. `openssl rand -base64 24`.

# Keycloak admin console login
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=
# Password for the keycloak postgres database (shared by keycloak_web and keycloakdb)
KEYCLOAK_DB_PASSWORD=

# Secrets of the two confidential clients in keycloak/realm-export.json
IB_API_CLIENT_SECRET=
IB_KC_API_CLIENT_SECRET=
# Password of the seeded ib_admin@javatodev.com realm user
IB_ADMIN_USER_PASSWORD=

# MySQL root password and the password of the javatodev_development application user
# (must match spring.datasource.password served by the config server for each service)
MYSQL_ROOT_PASSWORD=
MYSQL_APP_USER_PASSWORD=
